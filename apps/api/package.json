{
  "name": "@resonance/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "pnpm --filter @resonance/shared build && vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "pnpm --filter @resonance/shared build && tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@resonance/shared": "workspace:*",
    "@octokit/rest": "^20.0.0",
    "@octokit/auth-app": "^6.0.0",
    "@octokit/webhooks": "^13.0.0",
    "zod": "^3.22.0",
    "dotenv": "^16.3.0",
    "axios": "^1.6.0",
    "diff": "^9.0.0",
    "fastify": "^4.24.0",
    "tavily": "^2.0.0",
    "openai": "^4.20.0",
    "pino": "^9.0.0",
    "pino-pretty": "^10.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "tsx": "^4.6.0",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0"
  }
}