# Resonance Core — Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# NEBIUS AI STUDIO
# ===========================================
# Get your API key from https://studio.nebius.com/
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1

# Model names (verify exact names in Nebius dashboard)
NEBIUS_TRIAGE_MODEL=nvidia/nemotron-nano
NEBIUS_SYNTHESIS_MODEL=nvidia/nemotron-3-ultra

# ===========================================
# TAVILY SEARCH API
# ===========================================
# Get your API key from https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_BASE_URL=https://api.tavily.com

# ===========================================
# GITHUB APP
# ===========================================
# Create a GitHub App at https://github.com/settings/apps
# Required permissions:
#   - Contents: Read & Write
#   - Pull requests: Read & Write
#   - Actions: Read
#   - Metadata: Read
# Webhook URL: https://your-domain.com/webhook
# Webhook events: Workflow runs, Check runs

GITHUB_APP_ID=your_github_app_id
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
GITHUB_CLIENT_ID=your_client_id_optional
GITHUB_CLIENT_SECRET=your_client_secret_optional

# ===========================================
# SERVER CONFIGURATION
# ===========================================
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# ===========================================
# AUTONOMY CONFIGURATION
# ===========================================
# Default tier: 1=Guardian, 2=Co-Pilot, 3=Autopilot
DEFAULT_AUTONOMY_TIER=2

# ===========================================
# COST TRACKING
# ===========================================
# Rates per 1K tokens (update from Nebius pricing)
COST_RATE_NEMOTRON_NANO=0.0001
COST_RATE_NEMOTRON_ULTRA=0.0005

# ===========================================
# OPTIONAL: SLACK NOTIFICATIONS
# ===========================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/XXX/XXX

# ===========================================
# OPTIONAL: LOGGING
# ===========================================
LOG_LEVEL=info